  "identification": {
    "minScoreThreshold": 80,
    "rules": [
      {
        "type": "exact_text",
        "value": "PROVEEDOR REAL:",
        "weight": 30
      },
      {
        "type": "fuzzy_text",
        "value": "CONDICION PAGO PROVEEDOR",
        "weight": 25
      },
      {
        "type": "regex",
        "value": "ORDEN N.?\\s*\\d+\\s+Rv\\.",
        "weight": 25
      },
      {
        "type": "exact_text",
        "value": "FACTURA PROVEEDOR",
        "weight": 20
      }
    ]
  },
